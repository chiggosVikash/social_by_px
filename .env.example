# ============================================================
# social_by_px — Environment Variables
# Copy this file to .env and fill in your actual values.
# ⚠️  Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Database Configuration
# PostgreSQL connection strings (async + sync)
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/social_by_px
SYNC_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/social_by_px

# ------------------------------------------------------------
# Redis Configuration
# Used for background task queue (ARQ/workers)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# AI / LLM API Keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# ------------------------------------------------------------
# Meta Graph API (Facebook & Instagram publishing)
# Create an app at https://developers.facebook.com/
# ------------------------------------------------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------
# Cloudflare R2 (media storage)
# Get credentials from https://dash.cloudflare.com/ → R2
# ------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=social-by-px-media

# ------------------------------------------------------------
# Next.js — Frontend Settings
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
